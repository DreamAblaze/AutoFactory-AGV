<?xml version="1.0"?>

<sdf version="1.6">

  <model name="aruco_marker_0">

    <static>true</static>

    <link name="marker_link">

      <!-- 地面底座 -->
      <visual name="base_visual">
        <pose>0 0 0.01 0 0 0</pose>

        <geometry>
          <box>
            <size>0.18 0.12 0.02</size>
          </box>
        </geometry>

        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <collision name="base_collision">
        <pose>0 0 0.01 0 0 0</pose>

        <geometry>
          <box>
            <size>0.18 0.12 0.02</size>
          </box>
        </geometry>
      </collision>

      <!-- 支撑杆 -->
      <visual name="pole_visual">
        <pose>0 0 0.12 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.20 0.20 0.20 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
        </material>
      </visual>

      <collision name="pole_collision">
        <pose>0 0 0.12 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Marker黑色背板，中心高度0.35m -->
      <visual name="marker_backing_visual">
        <pose>0 0 0.35 0 0 0</pose>

        <geometry>
          <box>
            <size>0.25 0.01 0.25</size>
          </box>
        </geometry>

        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>

      <collision name="marker_backing_collision">
        <pose>0 0 0.35 0 0 0</pose>

        <geometry>
          <box>
            <size>0.25 0.01 0.25</size>
          </box>
        </geometry>
      </collision>

      <!--
        ArUco正面纹理。
        Plane原本位于XY平面，绕X轴旋转90度后竖直。
        正面朝向模型局部-Y方向。
      -->
      <visual name="aruco_marker_visual">
        <pose>0 -0.006 0.35 1.57079632679 0 0</pose>

        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.24 0.24</size>
          </plane>
        </geometry>

        <material>
          <script>
            <uri>
              model://aruco_marker_0/materials/scripts
            </uri>

            <uri>
              model://aruco_marker_0/materials/textures
            </uri>

            <name>AutoFactory/ArucoMarker0</name>
          </script>
        </material>

        <cast_shadows>false</cast_shadows>
      </visual>

    </link>

  </model>

</sdf>
